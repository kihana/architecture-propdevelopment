            <mxPoint x="830" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="C2hiFcFEPLbmLEAzwZav-51" value="утечка этих данных может привести к потере потенциальных покупателей, потере доверия со стороны клиентов, а также нарушения законодательства о защите персональных данных" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="520" width="130" height="160" as="geometry" />
        </mxCell>
        <mxCell id="C2hiFcFEPLbmLEAzwZav-52" value="изменение цен или характеристик объектов недвижимости может ввести в заблуждение потенциальных клиентов и уменьшить их количество" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="520" width="130" height="130" as="geometry" />
        </mxCell>
        <mxCell id="C2hiFcFEPLbmLEAzwZav-53" value="утечка данных о сделках может предоставить конкурентам преимущества, например конкуренты предложат более выгодные условия клиентам или конкуренты увидят с какими характеристиками сделки заключаются чаще всего или с более выгодной ценой.&lt;div&gt;Потеря данных обернется потерей клиентов&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="520" width="130" height="280" as="geometry" />
        </mxCell>
        <mxCell id="C2hiFcFEPLbmLEAzwZav-54" value="некачественные данные могут оттолкнуть потенциальных клиентов от бронирования и заключения сделок" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="520" width="120" height="110" as="geometry" />
        </mxCell>
        <mxCell id="C2hiFcFEPLbmLEAzwZav-55" value="злоумышленники завладев данными для аутентификации могут совершать действия под видом реальных клиентов или собственников, что может обернуться серьезными финансовыми, репутационными и юридическими проблемами" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="520" width="120" height="210" as="geometry" />
        </mxCell>
        <mxCell id="C2hiFcFEPLbmLEAzwZav-56" value="утечка этих данных приведет к нарушению законодательства о защите персональных данных" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="520" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="C2hiFcFEPLbmLEAzwZav-57" value="потеря данных может привести к спорам с собственниками по оплаченным и не оплаченным услугам, что скажется на репутации компании" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="520" width="120" height="160" as="geometry" />
        </mxCell>
        <mxCell id="C2hiFcFEPLbmLEAzwZav-58" value="утечка финансовых данных может привести к значительным убыткам и нарушениям законодательства, связанным с защитой платёжных данных" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="520" width="120" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
